# Privy Configuration
# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id-here
# Server-only credential used to verify API callers.
PRIVY_APP_SECRET=your-privy-app-secret-here

# Monad Testnet Configuration
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Server-side primary and comma-separated fallbacks. Ask your infrastructure
# provider for a dedicated primary endpoint and keep the public endpoint last.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_FALLBACK_URLS=
NEXT_PUBLIC_MONAD_BLOCK_EXPLORER=https://testnet-explorer.monad.xyz
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Keep the public display quote and server settlement quote aligned. Replace with a
# signed quote provider before supporting volatile production FX.
NEXT_PUBLIC_NGN_PER_USDC=1580
NGN_PER_USDC=1580

# Requires gas sponsorship to be enabled for Monad in the Privy dashboard.
NEXT_PUBLIC_SPONSOR_GAS=true

# Testnet-only, authenticated, one claim per wallet. Never use a production key.
ENABLE_TESTNET_FAUCET=false
NEXT_PUBLIC_ENABLE_TESTNET_FAUCET=false
TESTNET_FAUCET_PRIVATE_KEY=0x_your_testnet_only_private_key
TESTNET_FAUCET_USDC_AMOUNT=25

# Database Configuration (Neon Postgres)
# Get your connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Optional: App URL for invite links (defaults to localhost:3000 in dev)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Explicitly opt in to seeded balances and migration utilities outside production.
ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Comma-separated wallet addresses allowed to access /api/operations.
ADMIN_WALLETS=
